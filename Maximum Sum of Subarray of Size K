public class Best3DaySales {
    public static void main(String[] args) {
        int[] sales = {200, 1500, 1000, 1800, 900, 200, 1700};
        int k = 3;
        int windowSum = 0;
        for (int i = 0; i < k; i++) {
            windowSum += sales[i];
        }
        int maxSum = windowSum;
        for (int i = k; i < sales.length; i++) {
            windowSum += sales[i] - sales[i - k];
            if (windowSum > maxSum) {
                maxSum = windowSum;
            }
        }
        System.out.println(maxSum);
    }
}
